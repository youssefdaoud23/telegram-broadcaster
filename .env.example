# Telegram Broadcaster - fresh installation template
# Generate a unique private .env with: python3 scripts/configure.py
# NEVER commit .env or re-generate the encryption key for existing data.

# Required Fernet secret. Generated by scripts/configure.py.
APP_ENCRYPTION_KEY=

# Persistent SQLite database and Telegram session files inside the container.
DATABASE_PATH=/data/broadcaster.sqlite3
TELEGRAM_SESSION_DIR=/data/telegram_sessions

# Docker Compose host binding (new installs default to loopback/SSH tunnel).
# To publish behind an HTTPS reverse proxy, the proxy can connect to 127.0.0.1:8789.
# Do not expose the service directly to the public Internet without access controls.
BROADCASTER_BIND_IP=127.0.0.1
BROADCASTER_PORT=8789

# false only for local HTTP/SSH tunnel; true behind HTTPS reverse proxy.
COOKIE_SECURE=false
SESSION_DAYS=7

# Sending always starts DISABLED. Enable only after deliberate setup and testing.
SEND_ENABLED=false

# Optional per-broadcast recipient cap. Unset/0/unlimited = no application cap.
# Telegram restrictions still apply regardless of this option.
# SEND_MAX_RECIPIENTS=20

# Informational site origin (not a reverse proxy/TLS configuration setting).
PUBLIC_BASE_URL=http://localhost:8789
